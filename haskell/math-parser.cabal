cabal-version:      2.4
name:               math-parser
version:            0.1.0
synopsis:           Fifteen math-expression evaluation strategies, idiomatic Haskell
build-type:         Simple

common warnings
    ghc-options: -Wall -O2

library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:  MathParser.Lexer
                      MathParser.Strategies
    build-depends:    base >=4 && <5
                    , array
                    , containers
    default-language: Haskell2010

executable bench
    import:           warnings
    hs-source-dirs:   app
    main-is:          Bench.hs
    build-depends:    base, time, math-parser
    -- A 64 MB nursery for both bench binaries (not the tests). With the
    -- default 1 MB one, n=10000 measured mostly minor GCs: on the laptop GC
    -- was ~20 % of the run, and -A64m cut n=10000 by 20-43 % for every
    -- strategy while leaving n<=1000 within noise. -rtsopts lets you
    -- override it: `cabal run bench -- +RTS -A1m -s`.
    ghc-options:      -rtsopts "-with-rtsopts=-A64m"
    default-language: Haskell2010

executable adversarial
    import:           warnings
    hs-source-dirs:   app
    main-is:          Adversarial.hs
    build-depends:    base, time, math-parser
    -- same nursery as bench, see there
    ghc-options:      -rtsopts "-with-rtsopts=-A64m"
    default-language: Haskell2010

test-suite test
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   app
    main-is:          Test.hs
    build-depends:    base, math-parser
    default-language: Haskell2010

-- Differential fuzz against the shared corpus (bench/fuzz/), mirroring
-- cpp/tests/fuzz_differential.cpp, python/test_fuzz.py and rust/tests/fuzz.rs.
-- A second test-suite: `cabal test` runs both this and `test` together, the
-- same way each other language runs correctness+fuzz under one invocation.
test-suite fuzz
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   app
    main-is:          Fuzz.hs
    build-depends:    base, directory, process, math-parser
    default-language: Haskell2010
